# Local FreeFilmCut defaults — start-filmcut.bat copies this to .env.local if missing.
# Auth / blog / Freesound cloud features need real services; the NLE editor UI can start with these placeholders.

# Node
NODE_ENV=development

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MARBLE_API_URL=https://api.marblecms.com
NEXT_PUBLIC_USE_THREE=1
# Optional Whisper model host (default tries huggingface.co then hf-mirror.com)
# NEXT_PUBLIC_HF_REMOTE_HOST=https://hf-mirror.com

# Server (placeholders OK for local editor preview)
DATABASE_URL=postgresql://opencut:opencut@localhost:5432/opencut
BETTER_AUTH_SECRET=freefilmcut-local-dev-secret-change-me

UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=example_token

MARBLE_WORKSPACE_KEY=your_workspace_key_here

FREESOUND_CLIENT_ID=your_client_id_here
FREESOUND_API_KEY=your_api_key_here
