{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"installCommand": "echo skip-install",
	"buildCommand": "echo skip-build",
	"outputDirectory": ".",
	"headers": [
		{
			"source": "/(.*)\\.mjs",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/javascript; charset=utf-8"
				}
			]
		}
	],
	"rewrites": [
		{
			"source": "/",
			"destination": "/editor/"
		}
	]
}
