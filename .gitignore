# Dependencies
node_modules/
**/node_modules/

# Build / cache
.next/
**/.next/
.turbo/
**/.turbo/
dist/
build/
# Asset editor needs prebuilt three.js modules on Vercel (static /build/*).
!three.js/build/
!three.js/build/**
.content-collections/
.open-next/
target/
.cargo-tools/

# Env / secrets
.env
.env.*
!.env.example
!**/.env.example

# OS / editor
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# Local tooling (not needed on GitHub)
.codegraph/
.cursor/
.workbuddy/
.cursorignore

# Scratch dumps under test/ (files still on disk; skip heavy media in git)
test/agent-scratch/**/*.mp4
test/agent-scratch/**/*.webm
test/agent-scratch/**/*.zip
test/agent-scratch/**/*_b64.txt
test/backups/_backup_before_git_recovery_*/

# Local Three.js editor project folders at repo root only
# (do NOT use bare "projects/" — that also ignored apps/web/src/app/projects/)
/projects/
**/.git.bak-upstream/
**/.git.bak*/
**/*.bak
**/*.bak-*

# Bun lock binary
bun.lockb

# Large local-only font extract (do not redistribute)
freefilmcut/apps/web/public/fonts/msyh.ttf

.worktrees/
